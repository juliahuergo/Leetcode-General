class Solution(object):
    def singleNonDuplicate(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """

        if len(nums) == 1:
            return nums[0]
        
        left = 0
        right = len(nums) - 1

        while left <= right:
            mid = (left+right) // 2

            if mid > 0 and mid < len(nums) - 1:
                if nums[mid] != nums[mid-1] and nums[mid] != nums[mid+1]:
                    return nums[mid]
                elif nums[mid] != nums[mid-1]:
                    pair_idx = mid
                else:
                    pair_idx = mid-1

            elif mid == 0:
                if nums[mid] != nums[mid+1]:
                    return nums[mid]
                
                pair_idx = mid
                        
            else: #if mid == len(nums) - 1
                if nums[mid] != nums[mid-1]:
                    return nums[mid]
                pair_idx = mid-1
            
            if pair_idx % 2 == 0: 
                left = mid+1
            else:
                right = mid
